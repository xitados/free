local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer

local PLATFORM_SIZE = Vector3.new(8, 1, 8)
local HEIGHT_STEP = 5 
local STEP_COOLDOWN = 0.15

local state = {
	enabled = true,
	platform = nil,
	character = nil,
	lastStepAt = 0,
	originalJumpPower = 50,
}

local function getCharacterParts()
	local character = LocalPlayer.Character
	if not character or not character.Parent then
		return nil, nil, nil
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")

	if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
		return character, nil, nil
	end

	return character, humanoid, root
end

local function removePlatform()
	if state.platform then
		state.platform:Destroy()
		state.platform = nil
	end
	state.character = nil

	local _, humanoid = getCharacterParts()
	if humanoid then
		humanoid.JumpPower = state.originalJumpPower
		humanoid.JumpHeight = 7.2
	end
end

local function createPlatform(character)
	if state.platform then
		state.platform:Destroy()
	end

	local platform = Instance.new("Part")
	platform.Name = "RidePlatform_Client"
	platform.Size = PLATFORM_SIZE
	platform.Transparency = 0.3
	platform.CastShadow = false
	platform.Anchored = true
	platform.CanCollide = true
	platform.CanTouch = false
	platform.CanQuery = false
	platform.TopSurface = Enum.SurfaceType.Smooth
	platform.BottomSurface = Enum.SurfaceType.Smooth
	platform.Parent = workspace

	state.platform = platform
	state.character = character
end

local function stepHeight(direction)
	if not state.enabled then return end

	local now = os.clock()
	if now - state.lastStepAt < STEP_COOLDOWN then return end
	state.lastStepAt = now

	local _, humanoid, root = getCharacterParts()
	if not humanoid or not root then return end

	root.CFrame = root.CFrame + Vector3.new(0, direction * HEIGHT_STEP, 0)

	local velocity = root.AssemblyLinearVelocity
	root.AssemblyLinearVelocity = Vector3.new(velocity.X, 0, velocity.Z)
end

RunService.Heartbeat:Connect(function()
	local character, humanoid, root = getCharacterParts()
	
	if not state.enabled then
		if state.platform then
			removePlatform()
		end
		return
	end

	if not humanoid or not root then
		removePlatform()
		return
	end

	humanoid.UseJumpPower = true
	humanoid.JumpPower = 0
	humanoid.JumpHeight = 0

	if state.character ~= character or not state.platform or not state.platform.Parent then
		createPlatform(character)
	end

	local platform = state.platform
	if platform then
		local footOffset = humanoid.HipHeight + (root.Size.Y * 0.5) + (platform.Size.Y * 0.5)
		platform.CFrame = CFrame.new(
			root.Position.X,
			root.Position.Y - footOffset,
			root.Position.Z
		)
	end
end)

