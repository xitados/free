    local minimizeBtn = Instance.new("TextButton")
    minimizeBtn.Size = UDim2.new(0, 20, 0, 20)
    minimizeBtn.Position = UDim2.new(1, -26, 0, 10)
    minimizeBtn.BackgroundTransparency = 1
    minimizeBtn.Text = "—"
    minimizeBtn.TextColor3 = Color3.fromRGB(200, 40, 40)
    minimizeBtn.Font = Enum.Font.SourceSansBold
    minimizeBtn.TextSize = 12
    minimizeBtn.Parent = topBar

    local contentFrame = Instance.new("Frame")
    contentFrame.Name = "ContentFrame"
    contentFrame.Size = UDim2.new(1, -120, 1, -50)
    contentFrame.Position = UDim2.new(0, 110, 0, 42)
    contentFrame.BackgroundColor3 = Color3.fromRGB(26, 14, 14)
    contentFrame.BorderSizePixel = 0
    contentFrame.Parent = mainFrame

    local cornerContent = Instance.new("UICorner")
    cornerContent.CornerRadius = UDim.new(0, 8)
    cornerContent.Parent = contentFrame

    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Size = UDim2.new(0.85, 0, 0, 32)
    toggleBtn.Position = UDim2.new(0.075, 0, 0.12, 0)
    toggleBtn.BackgroundColor3 = Color3.fromRGB(45, 20, 20)
    toggleBtn.BorderSizePixel = 0
    toggleBtn.Text = "AutoKill: OFF"
    toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    toggleBtn.Font = Enum.Font.SourceSansBold
    toggleBtn.TextSize = 13
    toggleBtn.Parent = contentFrame

    local cornerToggle = Instance.new("UICorner")
    cornerToggle.CornerRadius = UDim.new(0, 6)
    cornerToggle.Parent = toggleBtn

    local warningLabel = Instance.new("TextLabel")
    warningLabel.Size = UDim2.new(0.9, 0, 0, 65)
    warningLabel.Position = UDim2.new(0.05, 0, 0.45, 0)
    warningLabel.BackgroundTransparency = 1
    warningLabel.Text = "si se empieza a laguear apagalo y prendelo de nuevo si no funciona no lo uses"
    warningLabel.TextColor3 = Color3.fromRGB(255, 170, 0)
    warningLabel.Font = Enum.Font.SourceSansBold
    warningLabel.TextSize = 11
    warningLabel.TextWrapped = true
    warningLabel.TextYAlignment = Enum.TextYAlignment.Top
    warningLabel.Parent = contentFrame

    local dragging, dragInput, dragStart, startPos
    topBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = input.Position; startPos = mainFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)

    topBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    local isMinimized = false
    minimizeBtn.MouseButton1Click:Connect(function()
        isMinimized = not isMinimized
        contentFrame.Visible = not isMinimized
        mainFrame.Size = isMinimized and UDim2.new(0, 320, 0, 45) or UDim2.new(0, 320, 0, 180)
    end)

    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if not gameProcessed and input.KeyCode == Enum.KeyCode.M then
            mainFrame.Visible = not mainFrame.Visible
        end
    end)

    toggleBtn.MouseButton1Click:Connect(function()
        local newState = not KillAllEnabled
        setKillAllEnabled(newState)

        if newState then
            toggleBtn.Text = "AutoKill: ON"
            toggleBtn.BackgroundColor3 = Color3.fromRGB(140, 30, 30)
        else
            toggleBtn.Text = "AutoKill: OFF"
            toggleBtn.BackgroundColor3 = Color3.fromRGB(45, 20, 20)
        end
    end)
end

BuildCustomMenu()
