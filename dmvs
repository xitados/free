local function updateCharacterReferences()
    character = player.Character
    if not character then return end
    humanoid = character:FindFirstChildOfClass("Humanoid")
    rootPart = character:FindFirstChild("HumanoidRootPart")
    characterParts = {}
    if character then
        for _, part in pairs(character:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                table.insert(characterParts, part)
            end
        end
    end
end

local function applyTransparency(state)
    for _, part in pairs(characterParts) do
        if part and part.Parent then
            pcall(function()
                part.Transparency = state and 0.5 or 0
            end)
        end
    end
end

local function updateInvisibleButton()
    invisibleButton.Text = isInvisible and "A" or "D"
    invisibleButton.BackgroundColor3 = isInvisible
        and Color3.fromRGB(46, 160, 82)
        or Color3.fromRGB(48, 50, 54)
end

local function startInvisibleHeartbeat()
    if invisibleHeartbeatConnection then
        invisibleHeartbeatConnection:Disconnect()
        invisibleHeartbeatConnection = nil
    end
    invisibleHeartbeatConnection = RunService.Heartbeat:Connect(function()
        if isInvisible and rootPart and humanoid and rootPart.Parent and humanoid.Parent then
            local realCFrame = rootPart.CFrame
            local oldOffset = humanoid.CameraOffset

            local fakeCFrame = realCFrame * CFrame.new(0, 500, 0)
            local offsetDifference = fakeCFrame:ToObjectSpace(CFrame.new(realCFrame.Position)).Position

            rootPart.CFrame = fakeCFrame
            humanoid.CameraOffset = offsetDifference

            RunService.RenderStepped:Wait()

            if rootPart and rootPart.Parent then
                rootPart.CFrame = realCFrame
            end
            if humanoid and humanoid.Parent then
                humanoid.CameraOffset = oldOffset
            end
        end
    end)
end

local function stopInvisibleHeartbeat()
    if invisibleHeartbeatConnection then
        invisibleHeartbeatConnection:Disconnect()
        invisibleHeartbeatConnection = nil
    end
end

local function setLocalInvisible(enabled)
    isInvisible = enabled == true
    invisibleEnabled = isInvisible
    updateCharacterReferences()
    applyTransparency(isInvisible)

    if isInvisible then
        startInvisibleHeartbeat()
    else
        stopInvisibleHeartbeat()
        applyTransparency(false)
    end
    updateInvisibleButton()
end

