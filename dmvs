local activeESPs = {}
local MAX_ESP_DISTANCE = 1500

local serverDeadCharacters = setmetatable({}, { __mode = "k" })

local function cleanESP(targetPlayer)
    local espObj = activeESPs[targetPlayer]
    if not espObj then return end
    if espObj.Highlight then pcall(function() espObj.Highlight:Destroy() end) end
    if espObj.Line then pcall(function() espObj.Line:Remove() end) end
    if espObj.NameLabel then pcall(function() espObj.NameLabel:Remove() end) end
    activeESPs[targetPlayer] = nil
end

local function ensureESPDrawings(espObj)
    if not Drawing then return end

    if espLineEnabled and not espObj.Line then
        local ok, line = pcall(function() return Drawing.new("Line") end)
        if ok and line then
            espObj.Line = line
            pcall(function()
                line.Visible = false
                line.Thickness = 1.5
                line.Transparency = 1
            end)
        end
    end

    if espNameEnabled and not espObj.NameLabel then
        local ok, nameLabel = pcall(function() return Drawing.new("Text") end)
        if ok and nameLabel then
            espObj.NameLabel = nameLabel
            pcall(function()
                nameLabel.Visible = false
                nameLabel.Size = 13
                nameLabel.Center = true
                nameLabel.Outline = true
                nameLabel.Font = 2
            end)
        end
    end
end

local function WatchServerDeath(char)
    if not char then return end
    task.spawn(function()
        local hum = char:WaitForChild("Humanoid", 10)
        if not hum then return end

        if hum.Health <= 0 then
            serverDeadCharacters[char] = true
            local p = Players:GetPlayerFromCharacter(char)
            if p then cleanESP(p) end
            return
        end

        hum.Died:Connect(function()
            serverDeadCharacters[char] = true
            local p = Players:GetPlayerFromCharacter(char)
            if p then cleanESP(p) end
        end)
    end)
end

