    local viewportSize = camera.ViewportSize
    local lineStart = Vector2.new(viewportSize.X / 2, viewportSize.Y)

    for targetPlayer, espObj in pairs(activeESPs) do
        if espObj.Line or espObj.NameLabel then
            local char = espObj.Char
            local head = char and char:FindFirstChild("Head")
            local validTarget = inMatch
                and targetPlayer.Parent ~= nil
                and targetPlayer.Character == char
                and head ~= nil
                and serverDeadCharacters[char] ~= true
                and isEnemy(targetPlayer)

            local screenPosition, onScreen
            if validTarget then
                screenPosition, onScreen = camera:WorldToViewportPoint(head.Position)
                onScreen = onScreen and screenPosition.Z > 0
            end

            if espObj.Line then
                local showLine = espLineEnabled and validTarget and onScreen == true
                pcall(function()
                    espObj.Line.Visible = showLine
                    if showLine then
                        espObj.Line.From = lineStart
                        espObj.Line.To = Vector2.new(screenPosition.X, screenPosition.Y)
                        espObj.Line.Color = espLineColor
                    end
                end)
            end

            if espObj.NameLabel then
                local showName = espNameEnabled and validTarget and onScreen == true
                pcall(function()
                    espObj.NameLabel.Visible = showName
                    if showName then
                        espObj.NameLabel.Text = targetPlayer.Name
                        espObj.NameLabel.Position = Vector2.new(screenPosition.X, screenPosition.Y - 18)
                        espObj.NameLabel.Color = espNameColor
                    end
                end)
            end
        end
    end
end)

