local camlockTarget = nil
local CAMLOCK_PREDICTION = 0.25

local camlockRayParams = RaycastParams.new()
camlockRayParams.FilterType = Enum.RaycastFilterType.Exclude

local function FindNearestEnemyCamlock()
    local closestDist = math.huge
    local closestPart = nil
    local screenCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)

    local myChar = player.Character
    local myHead = myChar and (myChar:FindFirstChild("Head") or myChar:FindFirstChild("HumanoidRootPart"))
    if not myHead then return nil end
    local origin = myHead.Position

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and esEnemigoValido(p) then
            local char = p.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0 then
                    local pos2d, onScreen = camera:WorldToViewportPoint(hrp.Position)
                    if onScreen and pos2d.Z > 0 then
                        
                        camlockRayParams.FilterDescendantsInstances = { myChar, char }
                        local dir = hrp.Position - origin
                        local hit = workspace:Raycast(origin, dir, camlockRayParams)
                        
                        local visible = (not hit) or (hit.Instance and hit.Instance:IsDescendantOf(char))
                        if visible then
                            local dist = (screenCenter - Vector2.new(pos2d.X, pos2d.Y)).Magnitude
                            if dist < closestDist then
                                closestDist = dist
                                closestPart = hrp
                            end
                        end
                    end
                end
            end
        end
    end
    return closestPart
end

