local _animSwitching = false

Tabs.Anim:Section({ Title = "By BytOleek" })

for _, pack in ipairs(AnimPacks) do
    local tog = Tabs.Anim:Toggle({
        Title = pack.Name,
        Value = false,
        Callback = function(enabled)
            if _animSwitching then return end
            if enabled then
                _animSwitching = true
                
                for otherName, otherTog in pairs(AnimToggleElements) do
                    if otherName ~= pack.Name then
                        pcall(function() otherTog:Set(false) end)
                    end
                end
                _animSwitching = false
                SelectedAnim = pack.Ids
                SelectedAnimName = pack.Name
                task.spawn(function() ApplyAnims(pack.Ids) end)
            else
                if SelectedAnimName == pack.Name then
                    SelectedAnim = nil
                    SelectedAnimName = nil
                end
            end
        end
    })
    AnimToggleElements[pack.Name] = tog
end

player.CharacterAdded:Connect(function(char)
    local animate = char:WaitForChild("Animate", 5)
    if animate and SelectedAnim then
        task.wait(0.25)
        ApplyAnims(SelectedAnim)
    end
end)

local noTextureOriginals = {}
local noShadowOriginals = {}
local lightbrightOriginals = {}
local noTextureAddedConnection = nil
local noShadowAddedConnection = nil
local lightbrightAddedConnection = nil

local function rememberAndSet(snapshots, instance, property, value)
    local properties = snapshots[instance]
    if not properties then
        properties = {}
        snapshots[instance] = properties
    end
    if properties[property] == nil then
        local ok, originalValue = pcall(function() return instance[property] end)
        if not ok then return end
        properties[property] = originalValue
    end
    pcall(function() instance[property] = value end)
end

local function restorePerformanceProperties(snapshots)
    for instance, properties in pairs(snapshots) do
        local parentOk, parent = pcall(function() return instance.Parent end)
        if instance == Lighting or (parentOk and parent) then
            for property, originalValue in pairs(properties) do
                pcall(function() instance[property] = originalValue end)
            end
        end
    end
    table.clear(snapshots)
end

local function scanWorkspaceWhile(enabledCheck, callback)
    task.spawn(function()
        local descendants = workspace:GetDescendants()
        for index, instance in ipairs(descendants) do
            if not enabledCheck() then return end
            callback(instance)
            if index % 350 == 0 then task.wait() end
        end
    end)
end

local function applyNoTexture(instance)
    if instance:IsA("BasePart") then
        rememberAndSet(noTextureOriginals, instance, "Material", Enum.Material.SmoothPlastic)
        rememberAndSet(noTextureOriginals, instance, "MaterialVariant", "")
        rememberAndSet(noTextureOriginals, instance, "Reflectance", 0)
    end
    if instance:IsA("Decal") or instance:IsA("Texture") then
        rememberAndSet(noTextureOriginals, instance, "Transparency", 1)
    elseif instance:IsA("MeshPart") then
        rememberAndSet(noTextureOriginals, instance, "TextureID", "")
    elseif instance:IsA("SpecialMesh") then
        rememberAndSet(noTextureOriginals, instance, "TextureId", "")
    elseif instance:IsA("SurfaceAppearance") then
        rememberAndSet(noTextureOriginals, instance, "ColorMap", "")
        rememberAndSet(noTextureOriginals, instance, "MetalnessMap", "")
        rememberAndSet(noTextureOriginals, instance, "NormalMap", "")
        rememberAndSet(noTextureOriginals, instance, "RoughnessMap", "")
    end
end

local function setNoTexture(enabled)
    if NoTextureEnabled == enabled then return end
    NoTextureEnabled = enabled
    if enabled then
        noTextureAddedConnection = workspace.DescendantAdded:Connect(function(instance)
            if NoTextureEnabled then applyNoTexture(instance) end
        end)
        scanWorkspaceWhile(function() return NoTextureEnabled end, applyNoTexture)
    else
        if noTextureAddedConnection then noTextureAddedConnection:Disconnect(); noTextureAddedConnection = nil end
        restorePerformanceProperties(noTextureOriginals)
    end
end

local function applyNoShadows(instance)
    if instance:IsA("BasePart") then
        rememberAndSet(noShadowOriginals, instance, "CastShadow", false)
    end
end

local function setNoShadows(enabled)
    if NoShadowsEnabled == enabled then return end
    NoShadowsEnabled = enabled
    if enabled then
        rememberAndSet(noShadowOriginals, Lighting, "GlobalShadows", false)
        noShadowAddedConnection = workspace.DescendantAdded:Connect(function(instance)
            if NoShadowsEnabled then applyNoShadows(instance) end
        end)
        scanWorkspaceWhile(function() return NoShadowsEnabled end, applyNoShadows)
    else
        if noShadowAddedConnection then noShadowAddedConnection:Disconnect(); noShadowAddedConnection = nil end
        restorePerformanceProperties(noShadowOriginals)
    end
end

local function applyLightbrightAtmosphere(instance)
    if instance:IsA("Atmosphere") then
        rememberAndSet(lightbrightOriginals, instance, "Density", 0)
        rememberAndSet(lightbrightOriginals, instance, "Haze", 0)
        rememberAndSet(lightbrightOriginals, instance, "Glare", 0)
    end
end

local function setLightbright(enabled)
    if LightbrightEnabled == enabled then return end
    LightbrightEnabled = enabled
    if enabled then
        local brightSettings = {
            Brightness = 3,
            ClockTime = 14,
            FogStart = 0,
            FogEnd = 100000,
            Ambient = Color3.new(1, 1, 1),
            OutdoorAmbient = Color3.new(1, 1, 1),
            ExposureCompensation = 0.5,
            EnvironmentDiffuseScale = 1,
            EnvironmentSpecularScale = 1
        }
        for property, value in pairs(brightSettings) do
            rememberAndSet(lightbrightOriginals, Lighting, property, value)
        end
        for _, instance in ipairs(Lighting:GetDescendants()) do applyLightbrightAtmosphere(instance) end
        lightbrightAddedConnection = Lighting.DescendantAdded:Connect(function(instance)
            if LightbrightEnabled then applyLightbrightAtmosphere(instance) end
        end)
    else
        if lightbrightAddedConnection then lightbrightAddedConnection:Disconnect(); lightbrightAddedConnection = nil end
        restorePerformanceProperties(lightbrightOriginals)
    end
end

