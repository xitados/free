local Settings = { Language = "Espanol" }

local function normalizeLang(v)
    v = tostring(v or "")
    if v == "en" or v == "English" or v == "Ingles" then return "English" end
    return "Espanol"
end

local function currentLang() return normalizeLang(Settings.Language) end
local refreshTranslatableElements = function() end

local function setLang(v)
    Settings.Language = normalizeLang(v)
    pcall(function() WindUI:SetLanguage(Settings.Language) end)
    pcall(function() refreshTranslatableElements() end)
    return Settings.Language
end

local function L(key, ...)
    local code = currentLang()
